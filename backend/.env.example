# Longspan 模型 / 接口配置模板
#
# 用法（二选一）：
#   1) 复制成 backend/.env 后填写，重启后端即生效：
#        cp backend/.env.example backend/.env
#   2) 打开网站左下角「模型配置」面板填写，保存后即时生效（无需重启），
#      面板会把结果写回 backend/.env。
#
# 只填这三行就能跑真实模型：LLM_PROVIDER / LLM_API_KEY / LLM_MODEL
# （下面所有变量名都会被自动补上 LONGSPAN_ 前缀）

# ============ 模型与接口 ============
# auto         = 有 Key 就用真实模型，无 Key 自动退回演示（mock）
# openai-compat= 强制使用真实模型（OpenAI 兼容协议）
# mock         = 强制演示模式（不调用任何外部接口）
LLM_PROVIDER=auto

# 接口地址：填到 /v1 为止（后端会自己拼 /chat/completions）
# 常见服务商：
#   DeepSeek   https://api.deepseek.com/v1
#   OpenAI     https://api.openai.com/v1
#   Moonshot   https://api.moonshot.cn/v1
#   DashScope  https://dashscope.aliyuncs.com/compatible-mode/v1   （通义千问）
#   智谱 GLM   https://open.bigmodel.cn/api/paas/v4
#   本地 Ollama http://127.0.0.1:11434/v1   （Key 随便填个非空值）
LLM_BASE_URL=https://api.deepseek.com/v1

# 你的 API Key（形如 sk-xxxxxxxx）
LLM_API_KEY=

# 模型名（要跟上面的接口地址匹配）
#   ⚠️ 模型名变动很快，最稳的做法是在网站「模型配置」面板点「拉取」，
#      直接问服务商"你现在有哪些模型"，避免抄到已退役的名字。
#   DeepSeek: deepseek-flash（现行主模型）/ deepseek-v4-pro（更强更贵）
#             —— deepseek-chat、deepseek-reasoner 已于 2026-07 退役
#   OpenAI:   以 /v1/models 返回为准
#   Moonshot: 以平台模型列表为准
#   通义:     qwen-plus / qwen-max
#   智谱:     glm-4 系列
#   Ollama:   你 ollama list 里的名字
LLM_MODEL=deepseek-flash

# 单次请求超时（秒）与采样温度（长任务建议 ≤0.8 更稳）
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.7

# 备用模型链（可选，但强烈建议配一个）：主模型不可用时自动顶上，不必重跑整轮长任务。
# 逗号 / 分号 / 换行分隔，两种写法可混用：
#   模型名                      → 同一个接口地址下的另一个模型
#   模型名@https://xxx/v1       → 同时换接口地址（换服务商）
# 实测教训：中转站会给某个模型名恒返 503（No available workers），
#           而同系列另一个名字是通的 —— 这时候回退链能直接救回整轮任务。
# 例：LLM_FALLBACK_MODELS=deepseek-v4-pro
# 例：LLM_FALLBACK_MODELS=deepseek-v4-pro,V3@https://api.moonshot.cn/v1
LLM_FALLBACK_MODELS=

# ============ 其它（通常不用改）============
# 开发期 SQLite；上线改 postgresql+psycopg://user:pass@host/db
# DATABASE_URL=sqlite:///绝对路径/.data/longspan.db
